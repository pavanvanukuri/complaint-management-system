# Server Port
PORT=3000

# Session Secret (Generated automatically on Render Blueprint, or generate random string)
SESSION_SECRET=replace_with_a_long_random_secret

# Option 1: Cloud PostgreSQL (Render PostgreSQL, Supabase, Neon)
# Render Blueprint sets this automatically via render.yaml
DATABASE_URL=postgres://cms_user:password@hostname:5432/cms_db

# Option 2: Embedded SQLite (Zero config fallback, works out of the box with seed data)
# DB_DIALECT=sqlite
# SQLITE_PATH=./backend/data/cms.db

# Option 3: Oracle DB (For local Oracle 23ai / 26ai development)
# DB_DIALECT=oracle
# DB_USER=CMSUSER
# DB_PASSWORD=your_oracle_password
# DB_CONNECT_STRING=localhost:1521/FREEPDB1